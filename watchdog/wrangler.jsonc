{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Dead-man's switch for the runner (docs/runner.md). Lives on Cloudflare so it still alerts
  // when the Mac running the runner is asleep, offline or gone.
  "name": "isobot-watchdog",
  "main": "src/index.ts",
  "account_id": "e4265f322e6380ee832b83ad45e3e8c0",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "GRACE_MINUTES": "10" },
  "secrets": { "required": ["PING_TOKEN", "DISCORD_WEBHOOK_URL"] },
  "durable_objects": { "bindings": [{ "name": "WATCHDOG", "class_name": "Watchdog" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Watchdog"] }],
  "observability": { "enabled": true },
}
