{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "isobot-sandbox",
  "main": "src/index.ts",
  "account_id": "e4265f322e6380ee832b83ad45e3e8c0",
  "compatibility_date": "2026-10-29",
  // Files resolves Linux errno names through node:os; the API compares tokens with node:crypto.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // lite, standard-1 … standard-4. Site builds and Claude Code fit in standard-2.
    "INSTANCE_TYPE": "standard-2"
  },
  "secrets": {
    "required": ["SANDBOX_API_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN", "GITHUB_TOKEN"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SANDBOX", "class_name": "BuildSandbox" }]
  },
  "containers": [
    {
      "class_name": "BuildSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": { "dockerfile": "./Dockerfile" }
      }
    }
  ],
  "exports": {
    "BuildSandbox": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false
}
