# Existing Discord bot token. The Discord Gateway bridge runs on Fly.
DISCORD_BOT_TOKEN=

# Cloudflare Pi Worker origin and its shared bearer secret.
ISOBOT_AGENT_URL=https://isobot-pi.costream.workers.dev
ISOBOT_API_TOKEN=

# Fine-grained GitHub PAT with Issues read+write on src/config/repos.json repos.
# Configure the same token as a Cloudflare GITHUB_TOKEN secret for the Pi tool.
GITHUB_TOKEN=

# Keep the existing GitHub webhooks on Fly for issue/forum/comment sync.
GITHUB_WEBHOOK_SECRET=
# WEBHOOK_URL=https://isobot.fly.dev/gh/webhook
# PORT=8080

# Optional comma-separated Discord IDs; defaults to the application owner/team.
# ISOBOT_ALLOWED_USERS=123456789012345678,234567890123456789
