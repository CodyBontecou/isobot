{
  "name": "isobot-runner",
  "private": true,
  "type": "module",
  "description": "Always-on isobot runner: triages inbound work and builds, reviews, merges and releases approved GitHub issues.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test src/*.test.ts",
    "start": "node dist/main.js run",
    "dev": "tsx src/main.ts",
    "smoke": "tsx src/smoke.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
