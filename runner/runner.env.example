# Copy to ~/Library/Application Support/isobot/runner.env (chmod 600).
# The runner keeps these to itself: builders and checks never receive them.

# Fine-grained GitHub token for the configured repos: Contents, Issues and Pull
# requests read/write, Checks and Commit statuses read.
ISOBOT_GITHUB_TOKEN=

# Pi Worker and its prompt API token: lets triage read Discord history.
ISOBOT_PI_URL=https://pi.isolated.tech
ISOBOT_PI_TOKEN=

# Optional: Discord. With the bot token and a channel id, each job gets one status card that is
# edited as it moves, and a thread under it you can reply in (docs/runner.md#discord). Use the
# bridge's bot token; the bot needs View Channel, Send Messages, Embed Links, Create Public Threads
# and Send Messages in Threads there. A webhook alone gives one-line updates and no threads.
# ISOBOT_DISCORD_BOT_TOKEN=
# ISOBOT_DISCORD_CHANNEL_ID=
# ISOBOT_DISCORD_WEBHOOK_URL=
# Discord user ids allowed to use the staff chat (default: the bot application's owner).
# ISOBOT_CHAT_USERS=
# Channel the staff chat listens in (default: ISOBOT_DISCORD_CHANNEL_ID, the job-card channel).
# ISOBOT_CHAT_CHANNEL_ID=
# Optional "Open in isobot" button on each card; {id} becomes the job id (owner/repo#n).
# ISOBOT_JOB_URL=

# Optional but recommended: a dead-man's switch. The runner POSTs here every minute while
# healthy, so you hear about it when the Mac sleeps, loses network, crashes for good or every
# cycle fails. Use the watchdog Worker (https://isobot-watchdog.<subdomain>.workers.dev/ping/<PING_TOKEN>,
# see docs/runner.md) or any service that accepts a POST. Without it, a dead runner is silent.
# ISOBOT_HEARTBEAT_URL=
# Optional: cloud builds on Cloudflare for repos or content sites with "executor": "cloudflare"
# (docs/cloud-builds.md). The URL of the deployed isobot-sandbox Worker and its SANDBOX_API_TOKEN.
# ISOBOT_SANDBOX_URL=https://isobot-sandbox.<subdomain>.workers.dev
# ISOBOT_SANDBOX_TOKEN=

# Optional: push the runner's state, schedule and GitHub work to the isobot board (docs/board.md).
# The token is the board Worker's INGEST_TOKEN secret.
# ISOBOT_BOARD_URL=https://bot.isolated.tech
# ISOBOT_BOARD_TOKEN=

# Optional: this runner's name in claim leases (default: the host name). Give each runner its own,
# e.g. "laptop" and "mini", so two of them never build the same issue (docs/runner.md).
# ISOBOT_RUNNER_ID=
# Optional: "builder" on every runner but one. A builder only claims and builds approved issues; the
# primary (the default) also triages, chats, feeds the board, hands off to Herdr and runs every train.
# Two primaries would post and release twice (docs/runner.md#two-runners).
# ISOBOT_RUNNER_ROLE=builder

# Optional: email triage over IMAP, up to 9 mailboxes (second one uses ISOBOT_IMAP_USER_2 and so on).
# Add Gmail accounts with runner/scripts/add-mail-account.sh, which reads an app password from the
# clipboard. Gmail accounts default to ISOBOT_IMAP_QUERY="-from:me (category:primary OR to:isolated.tech)".
# ISOBOT_IMAP_USER=
# ISOBOT_IMAP_PASSWORD=
# ISOBOT_IMAP_HOST=imap.gmail.com
# ISOBOT_IMAP_MAILBOX=INBOX
# ISOBOT_IMAP_QUERY=

# Headless machines (the Mac mini): run `claude setup-token` once and paste the
# token here so builders use your subscription without a keychain prompt.
# CLAUDE_CODE_OAUTH_TOKEN=
