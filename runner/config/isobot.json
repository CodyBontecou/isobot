{
  "pollSeconds": 60,
  "triageMinutes": 30,
  "maxConcurrentJobs": 2,
  "maxProposalsPerTriage": 5,
  "builder": {
    "kind": "claude",
    "timeoutMinutes": 60,
    "maxTurns": 300,
    "maxFixRounds": 3,
    "maxReviewRounds": 2,
    "settings": {}
  },
  "labels": {
    "proposed": "isobot:proposed",
    "ready": "isobot:ready",
    "building": "isobot:building",
    "review": "isobot:review",
    "failed": "isobot:failed",
    "ship": "isobot:ship",
    "stop": "isobot:stop",
    "auto": "isobot:auto"
  },
  "trustedAuthors": [],
  "discordCategories": {
    "time.md": "codybontecou/time.md",
    "health.md": "codybontecou/health-md",
    "gitsync.md": "codybontecou/GitSync.md",
    "sync.md": "codybontecou/GitSync.md",
    "instarep.ly": "codybontecou/Instarep.ly",
    "whereday": "codybontecou/whereday",
    "iso.me": "codybontecou/whereday",
    "vox.md": "codybontecou/vox.md"
  },
  "vox": {
    "conversation": "isobot",
    "autoApprove": true,
    "minAutoApproveConfidence": 0.7,
    "maxProposalsPerNote": 3,
    "hints": "\"Vox\", \"box\", \"boxing\" or \"Voxboard\" = Vox.md (codybontecou/vox.md); \"Health and D\" or \"health MD\" = Health.md (codybontecou/health-md); \"time MD\" = time.md; \"where day\", \"iso me\" = whereday; \"git sync\" or \"sync MD\" = GitSync.md; \"insta reply\" = Instarep.ly."
  },
  "autoApprove": {
    "sources": [
      "discord",
      "github",
      "email",
      "appstore"
    ],
    "kinds": [
      "bug",
      "feature"
    ],
    "minConfidence": 0.8
  },
  "appStore": {
    "apps": {
      "6757763969": "codybontecou/health-md",
      "6758960270": "codybontecou/GitSync.md",
      "6754865693": "codybontecou/Instarep.ly",
      "6761960794": "codybontecou/whereday",
      "6758967337": "codybontecou/vox.md"
    },
    "countries": [
      "us",
      "gb",
      "ca",
      "au",
      "nz",
      "ie",
      "de",
      "fr",
      "es",
      "it",
      "nl",
      "se",
      "ch",
      "at",
      "jp",
      "kr",
      "br",
      "mx",
      "in"
    ]
  },
  "defaults": {
    "autonomy": "pr",
    "checks": [],
    "protectedPaths": [
      ".github/**",
      "**/.env*",
      "**/*.entitlements",
      "**/Info.plist",
      "**/*.storekit",
      "**/ExportOptions*.plist",
      "**/fastlane/**",
      "**/wrangler.json*",
      "**/wrangler.toml",
      "**/migrations/**",
      "**/*auth*/**",
      "**/*purchase*/**",
      "**/*subscription*/**",
      "**/*privacy*",
      ".claude/**",
      "**/CLAUDE.md",
      "**/AGENTS.md",
      ".mcp.json",
      ".codex/**",
      ".agents/**",
      ".pi/**",
      ".gitmodules",
      "**/.githooks/**",
      "**/.husky/**"
    ],
    "maxChangedLines": 400,
    "minReviewConfidence": 0.85,
    "requireCi": true,
    "release": {
      "onMerge": [],
      "onShip": []
    }
  },
  "repos": {
    "codybontecou/time.md": {
      "checks": [
        "xcodebuild -scheme 'time.md' -destination 'platform=macOS' -configuration Debug CODE_SIGNING_ALLOWED=NO -quiet test"
      ],
      "notes": "macOS app distributed outside the App Store (Developer ID, Sparkle), plus mobile/ (Expo) and sync-worker/. PR CI builds and tests macOS."
    },
    "codybontecou/health-md": {
      "checks": [
        "make test-contracts",
        "make apple-ios"
      ],
      "notes": "Monorepo: Apple app under apps/apple (HealthMd.xcodeproj), Android under apps/android, Rust core and CLI. PR CI only runs scripts/ci/run.py, so the local checks are what verify the iOS app."
    },
    "codybontecou/GitSync.md": {
      "checks": [
        "! grep -E 'CURRENT_PROJECT_VERSION = [^;]+;' Sync.md.xcodeproj/project.pbxproj | grep -vE '= [0-9]{12};'",
        "xcodebuild build-for-testing -project Sync.md.xcodeproj -scheme Sync.md -destination 'generic/platform=iOS Simulator' -quiet CODE_SIGNING_ALLOWED=NO"
      ],
      "notes": "iOS git client (Sync.md.xcodeproj, scheme Sync.md). CURRENT_PROJECT_VERSION must stay a 12-digit YYYYMMDDHHMM value. PR CI (xctest.yml, SyncMDTests) runs the unit tests."
    },
    "codybontecou/Instarep.ly": {},
    "codybontecou/whereday": {
      "checks": [
        "python3 -m unittest discover -s scripts -p test_test_ios.py",
        "scripts/test-ios.sh"
      ],
      "notes": "iOS app (Xcode project IsoMe.xcodeproj, scheme IsoMe) plus Android. PR CI runs IsoMe XCTest."
    },
    "codybontecou/vox.md": {
      "ownerAutonomy": "merge",
      "checks": [
        "./scripts/test-project-contracts.sh"
      ],
      "notes": "SwiftUI iOS/Mac/Watch app plus an Android app under apps/android. GitHub Apple CI runs the full xcodebuild test suite on every PR."
    }
  }
}
