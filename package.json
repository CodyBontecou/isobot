{
  "name": "isobot",
  "version": "0.1.0",
  "description": "Discord isobot for isolated.tech with a Cloudflare Pi Durable agent and bidirectional GitHub issue sync.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && node -e \"require('node:fs').mkdirSync('dist/config',{recursive:true});require('node:fs').copyFileSync('src/config/repos.json','dist/config/repos.json')\"",
    "typecheck": "tsc --noEmit",
    "webhooks:register": "tsx src/webhooks/register.ts",
    "agent:dev": "npm --prefix cloudflare run dev",
    "agent:deploy": "npm --prefix cloudflare run deploy",
    "agent:typecheck": "npm --prefix cloudflare run typecheck",
    "agent:logs": "npm --prefix cloudflare run logs",
    "chatgpt": "node scripts/chatgpt.mjs",
    "test": "node --import tsx --test src/agent/*.test.ts src/webhooks/*.test.ts src/discord/*.test.ts src/handlers/*.test.ts cloudflare/src/*.test.ts runner/src/*.test.ts watchdog/src/*.test.ts sandbox/src/*.test.ts scripts/*.test.mjs",
    "bridge:deploy": "npm --prefix bridge run deploy",
    "bridge:typecheck": "npm --prefix bridge run typecheck",
    "watchdog:deploy": "npm --prefix watchdog run deploy",
    "watchdog:typecheck": "npm --prefix watchdog run typecheck",
    "sandbox:deploy": "npm --prefix sandbox run deploy",
    "sandbox:typecheck": "npm --prefix sandbox run typecheck",
    "runner": "npm --prefix runner run dev --",
    "runner:typecheck": "npm --prefix runner run typecheck"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.2",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
