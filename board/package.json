{
  "name": "isobot-board",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:ui && wrangler dev",
    "deploy": "npm run build:ui && wrangler deploy",
    "build:ui": "node scripts/build-ui.mjs",
    "typecheck": "tsc --noEmit && tsc -p ui/tsconfig.json",
    "logs": "wrangler tail isobot-board --format pretty"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "typescript": "^5.7.2",
    "wrangler": "4.155.0"
  }
}
